#!/bin/sh /etc/rc.common
START=99
STOP=9
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/python3 -m m3100_touch --base-url http://127.0.0.1:8088 --device /dev/input/event0 --lcd /dev/m3100-lcd --status /run/m3100-touchscreen.json --lock /run/m3100-display.lock
  procd_set_param env PYTHONPATH=/opt/m3100-touchscreen PYTHONDONTWRITEBYTECODE=1
  procd_set_param respawn 60 5 3
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
