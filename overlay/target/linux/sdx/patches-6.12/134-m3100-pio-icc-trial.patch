--- /dev/null
+++ b/drivers/i2c/busses/i2c-qup-m3100-pio-icc.h
@@ -0,0 +1,20 @@
+/* Scoped M3100 PIO ICC request, kB/s (modern QUP normal bandwidth policy). */
+#ifndef I2C_QUP_M3100_PIO_ICC_H
+#define I2C_QUP_M3100_PIO_ICC_H
+#define M3100_PIO_ICC_PEAK 76800U
+struct m3100_pio_icc {
+ void *context;
+ int (*set_bw)(void *context, unsigned int peak);
+ bool active;
+};
+static int m3100_pio_icc_set(struct m3100_pio_icc *vote, bool enable)
+{
+ int ret;
+ if (vote->active == enable)
+  return 0;
+ ret=vote->set_bw(vote->context, enable ? M3100_PIO_ICC_PEAK : 0);
+ if (!ret)
+  vote->active=enable;
+ return ret;
+}
+#endif
