 static void qup_i2c_enable_clocks(struct qup_i2c_dev *qup)
 {
+ if (qup->m3100_clock_diag) {
+  /* Record existing calls only. Preserve order and ignored-error behavior. */
+  qup->m3100_enable_start_ns=ktime_get_boottime_ns();
+  qup->m3100_core_ret=clk_prepare_enable(qup->clk);
+  qup->m3100_enable_core_ns=ktime_get_boottime_ns();
+  qup->m3100_iface_ret=clk_prepare_enable(qup->pclk);
+  qup->m3100_enable_end_ns=ktime_get_boottime_ns();
+  qup->m3100_enable_seq++;
+ } else {
 	clk_prepare_enable(qup->clk);
 	clk_prepare_enable(qup->pclk);
+ }
 }
 
