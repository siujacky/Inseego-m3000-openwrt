--- /dev/null
+++ b/drivers/i2c/busses/i2c-qup-m3100-version.h
@@ -0,0 +1,41 @@
+/* M3100 exact version transaction core, shared by kernel and host fixtures.
+ * Stock output tags: START77W, WRITE3(800000), START77R, READ4+STOP.
+ * Stock RX framing is two overhead bytes followed by four data bytes.
+ * Numeric overhead values are intentionally not invented or validated.
+ */
+static const unsigned char m3100_version_tx[11]={0x81,0xee,0x82,3,0x80,0,0,0x81,0xef,0x87,4};
+static int m3100_version_shape(unsigned int n,unsigned int a0,unsigned int f0,unsigned int l0,
+ const unsigned char *tx,unsigned int a1,unsigned int f1,unsigned int l1)
+{
+ return n==2 && a0==0x77 && f0==0 && l0==3 && tx &&
+ tx[0]==0x80 && tx[1]==0 && tx[2]==0 && a1==0x77 && f1==1 && l1==4;
+}
+static unsigned int m3100_version_tx_word(unsigned int word)
+{
+ unsigned int value=0,j;
+ for(j=0;j<4;j++)if(word*4+j<11)value|=(unsigned int)m3100_version_tx[word*4+j]<<(8*j);
+ return value;
+}
+static int m3100_version_irq_result(unsigned int bus,unsigned int core,unsigned int op)
+{
+ if(bus||core)return (bus&8)?-ENXIO:-EIO;
+ return (op&(1U<<11))?1:0;
+}
+struct m3100_version_fifo {
+ void *context;
+ unsigned int (*op)(void *);
+ unsigned int (*word)(void *);
+};
+static int m3100_version_receive(struct m3100_version_fifo *fifo,unsigned char out[4],unsigned char overhead[2])
+{
+ unsigned char raw[8];unsigned int i,j,word;
+ for(i=0;i<2;i++) {
+  if(!(fifo->op(fifo->context)&(1U<<5)))return -EMSGSIZE;
+  word=fifo->word(fifo->context);
+  for(j=0;j<4;j++)raw[i*4+j]=word>>(8*j);
+ }
+ if(fifo->op(fifo->context)&(1U<<5))return -EOVERFLOW;
+ for(i=0;i<4;i++)out[i]=raw[i+2];
+ overhead[0]=raw[0];overhead[1]=raw[1];
+ return 0;
+}
