+static bool qup_m3100_combined_match(struct qup_i2c_dev *qup,struct i2c_msg *msgs,int num)
+{
+ if (!qup->m3100_diag || !qup->m3100_combined_trial || num!=2) return false;
+ return m3100_version_shape(num,msgs[0].addr,msgs[0].flags,msgs[0].len,msgs[0].buf,
+                            msgs[1].addr,msgs[1].flags,msgs[1].len);
+}
+static int qup_m3100_combined_errors(struct qup_i2c_dev *qup)
+{
+ u32 bus,core;
+ int ret=READ_ONCE(qup->m3100_combined_error);
+ if (ret) return ret;
+ bus=READ_ONCE(qup->bus_err)|(readl(qup->base+QUP_I2C_STATUS)&I2C_STATUS_ERROR_MASK);
+ core=READ_ONCE(qup->qup_err)|(readl(qup->base+QUP_ERROR_FLAGS)&QUP_STATUS_ERROR_FLAGS);
+ ret=m3100_version_irq_result(bus,core,0);
+ return ret<0?ret:0;
+}
+static unsigned int qup_m3100_fifo_op(void *context)
+{
+ struct qup_i2c_dev *qup=context;
+ return readl(qup->base+QUP_OPERATIONAL);
+}
+static unsigned int qup_m3100_fifo_word(void *context)
+{
+ struct qup_i2c_dev *qup=context;
+ return readl(qup->base+QUP_IN_FIFO_BASE);
+}
+/* Exact stock-style combined version request, never a general adapter mode. */
+static int qup_m3100_combined_version(struct qup_i2c_dev *qup,struct i2c_msg *msgs)
+{
+ struct m3100_version_fifo fifo={.context=qup,.op=qup_m3100_fifo_op,.word=qup_m3100_fifo_word};
+ u8 data[4],overhead[2];
+ u32 value;
+ unsigned int i;
+ int ret,reset_ret;
+ if (qup->out_fifo_sz<11 || qup->in_fifo_sz<6) return -EOPNOTSUPP;
+ qup->use_dma=false;
+ qup->msg=&msgs[1];
+ WRITE_ONCE(qup->m3100_combined_done,false);
+ WRITE_ONCE(qup->m3100_combined_error,0);
+ reinit_completion(&qup->xfer);
+ WRITE_ONCE(qup->m3100_combined_active,true);
+ qup_m3100_stage(qup,"combined-before-irq");
+ qup_m3100_boundary(qup,"before-enable-irq");
+ enable_irq(qup->irq);
+ /* Stock enables IRQ before configuring the complete request. Keep errors. */
+ ret=qup_m3100_combined_errors(qup); if(ret) goto stop;
+ qup_m3100_stage(qup,"combined-reset");
+ ret=qup_i2c_change_state(qup,QUP_RESET_STATE); if(ret) goto stop;
+ ret=qup_m3100_combined_errors(qup); if(ret) goto stop;
+ writel(0,qup->base+QUP_MX_INPUT_CNT);
+ writel(0,qup->base+QUP_MX_OUTPUT_CNT);
+ writel(6,qup->base+QUP_MX_READ_CNT);
+ writel(11,qup->base+QUP_MX_WRITE_CNT);
+ value=readl(qup->base+QUP_CONFIG);
+ value&=~(QUP_NO_INPUT|BIT(6)|0x1f|0xf00);
+ value|=I2C_MINI_CORE|I2C_N_VAL_V2;
+ writel(value,qup->base+QUP_CONFIG);
+ value=readl(qup->base+QUP_IO_MODE);
+ value&=~(GENMASK(13,10)|QUP_REPACK_EN|BIT(16));
+ writel(value|QUP_REPACK_EN,qup->base+QUP_IO_MODE);
+ ret=qup_m3100_combined_errors(qup); if(ret) goto stop;
+ qup_m3100_boundary(qup,"before-first-run");
+ qup_m3100_stage(qup,"combined-first-run");
+ ret=qup_i2c_change_state(qup,QUP_RUN_STATE);
+ qup_m3100_boundary(qup,"after-first-run");
+ if(ret) goto stop;
+ ret=qup_m3100_combined_errors(qup); if(ret) goto stop;
+ writel(qup->clk_ctl,qup->base+QUP_I2C_CLK_CTL);
+ qup_m3100_stage(qup,"combined-first-pause");
+ ret=qup_i2c_change_state(qup,QUP_PAUSE_STATE);
+ qup_m3100_boundary(qup,"after-first-pause");
+ if(ret) goto stop;
+ ret=qup_m3100_combined_errors(qup); if(ret) goto stop;
+ for(i=0;i<3;i++) writel(m3100_version_tx_word(i),qup->base+QUP_OUT_FIFO_BASE);
+ qup_m3100_stage(qup,"combined-message-run");
+ ret=qup_i2c_change_state(qup,QUP_RUN_STATE); if(ret) goto stop;
+ ret=qup_m3100_combined_errors(qup); if(ret) goto stop;
+ qup_m3100_stage(qup,"combined-input-done");
+ ret=qup_i2c_wait_for_complete(qup,&msgs[1]);
+stop:
+ /* Serialize the final error/done decision and FIFO drain against the ISR. */
+ disable_irq(qup->irq);
+ if (!ret) ret=qup_m3100_combined_errors(qup);
+ if (!ret && !READ_ONCE(qup->m3100_combined_done)) ret=-ENODATA;
+ if (!ret) ret=m3100_version_receive(&fifo,data,overhead);
+ if (!ret) ret=qup_m3100_combined_errors(qup);
+ if (!ret) ret=qup_i2c_bus_active(qup,ONE_BYTE);
+ if (ret) qup_m3100_task_snapshot(qup);
+ reset_ret=qup_i2c_change_state(qup,QUP_RESET_STATE);
+ if (!ret) ret=reset_ret;
+ if (!ret) ret=qup_m3100_combined_errors(qup);
+ WRITE_ONCE(qup->m3100_combined_active,false);
+ qup->msg=NULL;
+ if (!ret) {
+  memcpy(msgs[1].buf,data,4);
+  dev_info(qup->dev,"M3100 combined version transaction complete: TX11 RX6 overhead=%02x,%02x\n",overhead[0],overhead[1]);
+ }
+ return ret?ret:2;
+}
