+/* Six read-only boundary snapshots, only the first exact version transaction.
+ * Written/read in the serialized transfer task; IRQ never touches this array.
+ */
+static void qup_m3100_boundary(struct qup_i2c_dev *qup, const char *stage)
+{
+ struct qup_m3100_error *entry;
+ if (!qup->m3100_diag || !qup->m3100_trace_active ||
+     !READ_ONCE(qup->m3100_active) || qup->m3100_trace_count>=6) return;
+ entry=&qup->m3100_trace[qup->m3100_trace_count++];
+ entry->ns=ktime_get_boottime_ns(); entry->stage=stage;
+ entry->state=readl(qup->base+QUP_STATE);
+ entry->status=readl(qup->base+QUP_I2C_STATUS);
+ entry->error=readl(qup->base+QUP_ERROR_FLAGS);
+ entry->op=readl(qup->base+QUP_OPERATIONAL);
 }
 
