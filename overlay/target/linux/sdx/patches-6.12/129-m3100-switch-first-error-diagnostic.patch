+/* Snapshot only the first error, while clocks are active and before recovery.
+ * No printk in the IRQ path; output is delayed until transfer completion.
+ */
+static void qup_m3100_stage(struct qup_i2c_dev *qup, const char *stage)
+{
+ if (qup->m3100_diag) WRITE_ONCE(qup->m3100_stage,stage);
+}
+static void qup_m3100_snapshot(struct qup_i2c_dev *qup, const char *origin,
+                             u32 status, u32 error, u32 op)
+{
+ unsigned long flags;
+ if (!qup->m3100_diag) return;
+ spin_lock_irqsave(&qup->m3100_lock,flags);
+ if (!qup->m3100_active || qup->m3100_fault_valid) goto out;
+ qup->m3100_fault.ns=ktime_get_boottime_ns();
+ qup->m3100_fault.stage=READ_ONCE(qup->m3100_stage);
+ qup->m3100_fault.origin=origin;
+ qup->m3100_fault.msg_idx=READ_ONCE(qup->m3100_msg_idx);
+ qup->m3100_fault.status=status; qup->m3100_fault.error=error; qup->m3100_fault.op=op;
+ qup->m3100_fault.state=readl(qup->base+QUP_STATE);
+ qup->m3100_fault_valid=true;
+out:
+ spin_unlock_irqrestore(&qup->m3100_lock,flags);
+}
+static void qup_m3100_task_snapshot(struct qup_i2c_dev *qup)
+{
+ unsigned long flags;
+ if (!qup->m3100_diag) return;
+ spin_lock_irqsave(&qup->m3100_lock,flags);
+ if (!qup->m3100_active || qup->m3100_fault_valid) goto out;
+ qup->m3100_fault.ns=ktime_get_boottime_ns();
+ qup->m3100_fault.stage=READ_ONCE(qup->m3100_stage);
+ qup->m3100_fault.origin="task";
+ qup->m3100_fault.msg_idx=READ_ONCE(qup->m3100_msg_idx);
+ qup->m3100_fault.status=readl(qup->base+QUP_I2C_STATUS);
+ qup->m3100_fault.error=readl(qup->base+QUP_ERROR_FLAGS);
+ qup->m3100_fault.op=readl(qup->base+QUP_OPERATIONAL);
+ qup->m3100_fault.state=readl(qup->base+QUP_STATE);
+ qup->m3100_fault_valid=true;
+out:
+ spin_unlock_irqrestore(&qup->m3100_lock,flags);
+}
