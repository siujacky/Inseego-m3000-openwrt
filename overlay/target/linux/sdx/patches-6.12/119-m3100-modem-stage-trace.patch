+	m3100_stage("after q6v5 prepare");
 	if (ret)
 		return ret;
 
+	m3100_stage("before power domains");
 	ret = adsp_pds_enable(adsp, adsp->proxy_pds, adsp->proxy_pd_count);
+	m3100_stage("after power domains");
 	if (ret < 0)
