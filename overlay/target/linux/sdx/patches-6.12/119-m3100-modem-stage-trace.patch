 	}
 
 	if (adsp->px_supply) {
+		m3100_stage("before PX regulator");
 		ret = regulator_enable(adsp->px_supply);
+		m3100_stage("after PX regulator");
 		if (ret)
 			goto disable_cx_supply;
 	}
@@ -300,27 +323,35 @@
 		}
 	}
 
+	m3100_stage("before PAS metadata init");
 	ret = qcom_mdt_pas_init(adsp->dev, adsp->firmware, rproc->firmware, adsp->pas_id,
