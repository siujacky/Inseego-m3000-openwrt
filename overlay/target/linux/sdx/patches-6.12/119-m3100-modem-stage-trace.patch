+static void m3100_stage(const char *stage)
+{
+	if (!of_machine_is_compatible("inseego,m3100"))
+		return;
+	pr_info("M3100 modem stage: %s\n", stage);
+	/* Allow the asynchronous USB console to transmit before a secure call. */
+	msleep(250);
+}
+
 static int adsp_load(struct rproc *rproc, const struct firmware *fw)
 {
 	struct qcom_adsp *pas = rproc->priv;
 	int ret;
+
+	m3100_stage("load entered");
 
 	/* Store firmware handle to be used in adsp_start() */
 	pas->firmware = fw;
@@ -263,30 +274,42 @@
 	struct qcom_adsp *adsp = rproc->priv;
 	int ret;
 
+	m3100_stage("before q6v5 prepare");
