+/* Exact M3100 stock switch WA, opt-in RAM trial. Shared host-test core. */
+static void m3100_wa_address(unsigned char *out, unsigned int reg)
+{ out[0]=reg>>16; out[1]=reg>>8; out[2]=reg; }
+static void m3100_wa_data(unsigned char *out, unsigned int value)
+{ unsigned int i; for(i=0;i<4;i++) out[i]=value>>(8*i); }
+static unsigned int m3100_wa_decode(const unsigned char *in)
+{ return (unsigned int)in[0]|(unsigned int)in[1]<<8|(unsigned int)in[2]<<16|(unsigned int)in[3]<<24; }
+struct m3100_wa_pair { unsigned int reg, value; };
+struct m3100_wa_io {
+ void *context;
+ unsigned int last_reg;
+ int (*read)(void *, unsigned int, unsigned int *);
+ int (*write)(void *, unsigned int, unsigned int);
+};
