+static int m3100_wa_pairs(struct m3100_wa_io *io, const struct m3100_wa_pair *pairs, unsigned int count)
+{
+ unsigned int i, value; int ret;
+ for (i=0; i<count; i++) {
+  io->last_reg=pairs[i].reg;
+  ret=io->write(io->context,pairs[i].reg,pairs[i].value); if(ret) return ret;
+  ret=io->read(io->context,pairs[i].reg,&value); if(ret) return ret;
+  if(value!=pairs[i].value) return -EIO;
+ }
+ return 0;
+}
+static int m3100_wa_rmw(struct m3100_wa_io *io, unsigned int reg, unsigned int clear, unsigned int set)
+{
+ unsigned int value; int ret;
+ io->last_reg=reg; ret=io->read(io->context,reg,&value);
+ if(ret) return ret;
+ return io->write(io->context,reg,(value&~clear)|set);
+}
+static int m3100_wa_run(struct m3100_wa_io *io)
+{
+ unsigned int version, lane; int ret;
+ io->last_reg=0x800000;
+ ret=io->read(io->context,0x800000,&version); if(ret) return ret;
+ if((version&0xff)!=1) return -ENODEV;
+ ret=m3100_wa_pairs(io,stock_reg_update,sizeof(stock_reg_update)/sizeof(stock_reg_update[0])); if(ret) return ret;
+#define WA_WRITE(r,v) do { io->last_reg=r; ret=io->write(io->context,r,v); if(ret) return ret; } while(0)
+#define WA_RMW(r,c,s) do { ret=m3100_wa_rmw(io,r,c,s); if(ret) return ret; } while(0)
+ WA_WRITE(0x82c030,4); WA_WRITE(0x828240,0); WA_WRITE(0x82c030,2); WA_WRITE(0x828000,1);
+ for(lane=1;lane<=2;lane++) {
+  if(lane==2) { WA_WRITE(0x828000,2); }
+  WA_RMW(0x8280a0,0x80000,0); WA_RMW(0x82b0a4,1,0); WA_RMW(0x82bcd0,0,1);
+ }
+ WA_WRITE(0x80100c,0x80000000); WA_WRITE(0x801010,0xc0000000);
+ WA_WRITE(0x84d080,0); WA_WRITE(0x84f0e8,3); WA_WRITE(0x80100c,0);
+#undef WA_WRITE
+#undef WA_RMW
+ return m3100_wa_pairs(io,stock_switch_reg_update,sizeof(stock_switch_reg_update)/sizeof(stock_switch_reg_update[0]));
+}
