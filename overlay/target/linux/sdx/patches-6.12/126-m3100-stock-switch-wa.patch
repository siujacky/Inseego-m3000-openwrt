+/* Reserve the exact opt-in switch before runtime power, GPIO or PHY changes. */
+static int m3100_switch_prepare(struct device *dev, struct i2c_client **client)
+{
+ struct device_node *node, *expected;
+ struct i2c_adapter *adapter;
+ int ret;
+ if (!of_property_read_bool(dev->of_node,"inseego,m3100-stock-switch-wa"))
+  return 0;
+ if (!of_machine_is_compatible("inseego,m3100") ||
+     !of_device_is_compatible(dev->of_node,"qcom,pcie-sdx65"))
+  return -ENODEV;
+ node=of_parse_phandle(dev->of_node,"inseego,switch-i2c",0);
+ expected=of_find_node_by_path("/soc/i2c@835000");
+ if (!node || !expected || node!=expected || !of_device_is_available(node) ||
+     !of_device_is_compatible(node,"qcom,i2c-qup-v2.2.1")) {
+  of_node_put(node); of_node_put(expected); return -EINVAL;
+ }
+ of_node_put(expected);
+ adapter=of_find_i2c_adapter_by_node(node);
+ of_node_put(node);
+ if (!adapter) return -EPROBE_DEFER;
+ if (!i2c_check_functionality(adapter,I2C_FUNC_I2C)) {
+  i2c_put_adapter(adapter); return -EOPNOTSUPP;
+ }
+ /* No OF child is added. If address77 is owned, fail rather than steal it. */
+ *client=devm_i2c_new_dummy_device(dev,adapter,0x77);
+ i2c_put_adapter(adapter);
+ if (IS_ERR(*client)) { ret=PTR_ERR(*client); *client=NULL; return ret; }
+ return 0;
+}
+static int m3100_switch_read(void *context, unsigned int reg, unsigned int *value)
+{
+ struct i2c_client *client=context;
+ u8 address[3], data[4];
+ struct i2c_msg messages[2]={
+  {.addr=0x77,.len=3,.buf=address},
+  {.addr=0x77,.flags=I2C_M_RD,.len=4,.buf=data}
+ };
+ int ret;
+ m3100_wa_address(address,reg);
+ ret=i2c_transfer(client->adapter,messages,2);
+ if(ret!=2) return ret<0?ret:-EIO;
+ *value=m3100_wa_decode(data);
+ return 0;
+}
+static int m3100_switch_write(void *context, unsigned int reg, unsigned int value)
+{
+ struct i2c_client *client=context;
+ u8 data[7];
+ struct i2c_msg message={.addr=0x77,.len=7,.buf=data};
+ int ret;
+ m3100_wa_address(data,reg); m3100_wa_data(data+3,value);
+ ret=i2c_transfer(client->adapter,&message,1);
+ return ret==1?0:(ret<0?ret:-EIO);
+}
+static int m3100_switch_prelink(struct qcom_pcie *pcie)
+{
+ struct m3100_wa_io io={.context=pcie->m3100_switch,
+  .read=m3100_switch_read,.write=m3100_switch_write};
+ int ret;
+ if (!pcie->m3100_switch) return 0;
+ ret=m3100_wa_run(&io);
+ if(ret) { dev_err(pcie->pci->dev,"M3100 switch WA failed at reg%06x before LTSSM: %d\n",io.last_reg,ret); return ret; }
+ dev_info(pcie->pci->dev,"M3100 stock switch WA complete: version1, 56+16+6 operations\n");
+ msleep(20);
+ return 0;
+}
 
