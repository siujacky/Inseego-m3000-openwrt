#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name)" = 'inseego,m3100' ] || return 0
	[ -d /sys/class/remoteproc ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/m3100-modem-start
	procd_set_param stdout 1
	procd_set_param stderr 1
	# No respawn: retain a failed first attempt for diagnosis.
	procd_close_instance
}
