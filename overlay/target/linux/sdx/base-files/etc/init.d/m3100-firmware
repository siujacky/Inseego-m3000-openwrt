#!/bin/sh /etc/rc.common
START=97
USE_PROCD=1
start_service() {
	[ "$(cat /tmp/sysinfo/board_name)" = 'inseego,m3100' ] || return 0
	[ -d /proc/device-tree/reserved-memory/firmware-staging@a1000000 ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/m3100-firmware-load
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
