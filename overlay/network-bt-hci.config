# Merge into the current peripheral package profile, preserving selections.
CONFIG_PACKAGE_kmod-m3100-bt-hci=y
CONFIG_PACKAGE_m3100-bt-firmware=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_bluez-utils-btmon=y
# The custom package holds hci_uart outside /lib/modules for manual loading.
# CONFIG_PACKAGE_kmod-hci-uart is not set
# CONFIG_PACKAGE_bluez-daemon is not set
